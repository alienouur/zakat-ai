# انسخ هذا الملف باسم .env ثم عدّل القيم (كل سطر = إعداد واحد)

# المنفذ الذي سيفتح عليه الموقع داخل شبكة الصندوق (http://اسم-السيرفر:8080)
HOST_PORT=8080

# 1 = لا أحد يسأل النظام بدون تسجيل دخول (موصى به)
REQUIRE_LOGIN=1

# رمز الدعوة: من لا يعرفه لا يستطيع إنشاء حساب. اتركه فارغًا لفتح التسجيل للجميع.
INVITE_CODE=

# بريد (أو أكثر مفصولة بفاصلة) يصبح مشرفًا تلقائيًا عند التسجيل. أول حساب يُسجَّل يصير مشرفًا على كل حال.
ADMIN_EMAILS=

# الحد الأقصى لعدد الأسئلة لكل مستخدم في الدقيقة
RATE_LIMIT_PER_MINUTE=30

# 0 إذا كان الموقع يعمل بـ http داخل الشبكة فقط. 1 إذا كان خلف https (شهادة SSL).
COOKIE_SECURE=0

# مدة بقاء تسجيل الدخول بالأيام
SESSION_DAYS=30

# اختياري: مفتاح Gemini لتحسين صياغة الإجابات (الأحكام والأرقام لا تتغير). اتركه فارغًا للعمل بدون إنترنت.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
