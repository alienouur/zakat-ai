# انسخ هذا الملف باسم .env ثم عدّل القيم (كل سطر = إعداد واحد)

# المنفذ الذي سيفتح عليه الموقع داخل شبكة الصندوق (http://اسم-السيرفر:8080)
HOST_PORT=8080

# 1 = لا أحد يسأل النظام بدون تسجيل دخول (موصى به)
REQUIRE_LOGIN=1

# رمز الدعوة: من لا يعرفه لا يستطيع إنشاء حساب. اتركه فارغًا لفتح التسجيل للجميع.
INVITE_CODE=

# بريد (أو أكثر مفصولة بفاصلة) يصبح مشرفًا تلقائيًا عند التسجيل. أول حساب يُسجَّل يصير مشرفًا على كل حال.
ADMIN_EMAILS=

# الحد الأقصى لعدد الأسئلة لكل مستخدم في الدقيقة
RATE_LIMIT_PER_MINUTE=30

# 0 إذا كان الموقع يعمل بـ http داخل الشبكة فقط. 1 إذا كان خلف https (شهادة SSL).
COOKIE_SECURE=0

# مدة بقاء تسجيل الدخول بالأيام
SESSION_DAYS=30

# اختياري: مفتاح Gemini لتحسين صياغة الإجابات (الأحكام والأرقام لا تتغير). اتركه فارغًا للعمل بدون إنترنت.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# نموذج احتياطي يُستخدم تلقائيًا إذا فشل النموذج الأساسي بعد 3 محاولات (ازدحام 503/429 أو انقطاع)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# عدد المحاولات وزمن الانتظار الأساسي (1ث ثم 2ث ثم 4ث) ومهلة الاتصال بالثواني
LLM_RETRIES=3
LLM_RETRY_BASE_SECONDS=1
LLM_CONNECT_TIMEOUT_SECONDS=10


# ========== الشات بوت العام للمواطنين (مساعد صندوق الزكاة) ==========
# يعمل على منفذ مستقل (http://اسم-السيرفر:8090). يحتاج GEMINI_API_KEY أعلاه ليعمل.
CHATBOT_HOST_PORT=8090

# البريد الذي تصل إليه الشكاوى وطلبات الفتوى (مكتب المستشارين الشرعيين). لا يغيّره المستخدم ولا النموذج.
COMPLAINTS_EMAIL=complaints@zakatfund.gov.ly

# إعدادات خادم البريد (SMTP) لإرسال الرسائل. اطلبوها من مسؤول البريد في الصندوق.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true إذا كان المنفذ 465 (SSL)، false إذا كان 587 (STARTTLS)
SMTP_USE_SSL=false

# true = وضع التجربة: لا يُرسل بريد فعلي بل تُحفظ الرسائل كملفات داخل الحاوية. غيّروها إلى false بعد ضبط SMTP.
EMAIL_DRY_RUN=true

# رابط الموقع الذي ستُعرض عليه صفحة الشات بوت (للحماية CORS)، مثل https://mostashar.zakatfund.gov.ly
ALLOWED_ORIGINS=

# حدود الاستخدام
CHAT_RATE_LIMIT_PER_MINUTE=30
ESCALATIONS_PER_SESSION=3
ESCALATIONS_PER_IP_PER_HOUR=20

# اختياري: إن كان السيرفر في بلد لا تتوفر فيه خدمة Gemini (مثل ليبيا) ضعوا وسيطًا خارجيًا؛ يُستخدم لطلبات Gemini فقط
# HTTPS_PROXY=http://user:pass@proxy-host:3128
