# ---- مساعد صندوق الزكاة (chatbot/) — انسخ هذا الملف إلى .env واملأ القيم ----
# نموذج اللغة (Gemini). بدون المفتاح يرد المساعد برسالة أن الخدمة غير مفعّلة.
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-3.8-flash
# نماذج احتياطية تُجرَّب بالترتيب إذا فشل الأساسي بعد 3 محاولات (ازدحام 503/429 أو انقطاع).
# تنبيه: نماذج 2.5 لم تعد متاحة للمفاتيح الجديدة (ترجع 404) فلا تستخدموها.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.1-pro-preview
# عدد المحاولات وزمن الانتظار الأساسي (1ث ثم 2ث ثم 4ث) ومهلة الاتصال بالثواني
LLM_RETRIES=3
LLM_RETRY_BASE_SECONDS=1
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# مجلد تعليمات النظام وتعريف الأداة (غير مرفوع إلى GitHub) ومجلد البيانات
CHATBOT_CONFIG_DIR=config
CHATBOT_DATA_DIR=data

# بريد الشكاوى (المستلم ثابت ولا يأتي من النموذج أبدًا)
COMPLAINTS_EMAIL=complaints@zakatfund.gov.ly
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=assistant@zakatfund.gov.ly
SMTP_PASSWORD=change-me
SMTP_FROM=assistant@zakatfund.gov.ly
SMTP_USE_SSL=false
# true = لا يُرسل بريد فعلي؛ تُكتب الرسائل في data/outbox/*.eml (للتجربة)
EMAIL_DRY_RUN=true

# الأمان والحدود
ALLOWED_ORIGINS=https://mostashar.zakatfund.gov.ly
CHAT_RATE_LIMIT_PER_MINUTE=30
ESCALATIONS_PER_SESSION=3
ESCALATIONS_PER_IP_PER_HOUR=20
MAX_MESSAGE_CHARS=2000
MAX_SESSION_MESSAGES=40
SESSION_RETENTION_DAYS=30

# اختياري: إن كان السيرفر في بلد لا تتوفر فيه خدمة Gemini (مثل ليبيا) ضعوا وسيطًا خارجيًا؛ يُستخدم لطلبات Gemini فقط
# HTTPS_PROXY=http://user:pass@proxy-host:3128
